# App Store Connect submission lanes for CI (Release build / retry workflows).
#
# One App Store Connect app record (id1660218371) covers both Mac and iOS
# (bundle id com.ulriklyngs.mind-shield). Separate lanes upload platform
# binaries and stamp platform-filtered What's new from
# scripts/changelog-to-store-whats-new.js (untagged + [macos]/[ios]; see
# changelog-style.md).
#
# Auth (see docs/app-store-ci.md):
#   APP_STORE_CONNECT_API_KEY_ID
#   APP_STORE_CONNECT_API_ISSUER_ID
#   APP_STORE_CONNECT_API_KEY_P8          base64 of AuthKey_*.p8
#   ASC_PRIMARY_LOCALE                   optional; defaults to en-GB
#
# Usage:
#   fastlane mac submit_mac_app_store version:6.7.0 pkg:"path/to.pkg" notes:whats_new_mas.txt
#   fastlane ios submit_ios_app_store version:6.7.0 ipa:"path/to.ipa" notes:whats_new_ios.txt

APP_IDENTIFIER = "com.ulriklyngs.mind-shield"

def resolve_path(raw)
  p = raw.to_s.strip
  return nil if p.empty?
  return p if File.exist?(p)
  from_root = File.expand_path(p, "..")
  File.exist?(from_root) ? from_root : p
end

def asc_locale
  locale = ENV["ASC_PRIMARY_LOCALE"].to_s.strip
  locale.empty? ? "en-GB" : locale
end

def load_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID"),
    key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_P8"),
    is_key_content_base64: true
  )
end

def read_notes(options)
  notes_path = resolve_path(options.fetch(:notes))
  UI.user_error!("What's new file not found: #{options[:notes]}") unless notes_path && File.exist?(notes_path)
  notes = File.read(notes_path).strip
  UI.user_error!("What's new file is empty — nothing platform-facing to submit") if notes.empty?
  notes
end

# Listing copy lives in store-listing/ so CI does not depend on leftover
# App Store Connect text. Promo text also does not reliably persist across
# versions — stamp both every Mac / iOS submit.
def load_listing_copy
  listing_root = File.expand_path("../store-listing", __dir__)
  description_path = File.join(listing_root, "description.txt")
  promo_path = File.join(listing_root, "promotional_text.txt")
  UI.user_error!("Missing #{description_path}") unless File.exist?(description_path)
  UI.user_error!("Missing #{promo_path}") unless File.exist?(promo_path)
  description = File.read(description_path).strip
  promotional_text = File.read(promo_path).strip
  UI.user_error!("store-listing/description.txt is empty") if description.empty?
  UI.user_error!("store-listing/promotional_text.txt is empty") if promotional_text.empty?
  { description: description, promotional_text: promotional_text }
end

# Fail before deliver if this platform already has a version in review.
# Auto-withdrawing is intentionally not done — fix App Store Connect manually.
# Mac and iOS are checked separately (same ASC app record, different platforms).
def fail_if_app_store_review_in_progress!(app_identifier:, platform:, version:)
  app = Spaceship::ConnectAPI::App.find(app_identifier)
  UI.user_error!("App Store Connect app not found: #{app_identifier}") unless app

  platform_api = Spaceship::ConnectAPI::Platform.map(platform)
  store_label = platform.to_s == "osx" ? "Mac App Store" : "iOS App Store"

  submission = app.get_in_progress_review_submission(
    platform: platform_api,
    includes: "appStoreVersionForReview"
  )
  return if submission.nil?

  blocked = submission.app_store_version_for_review
  blocked_version = blocked&.version_string.to_s
  blocked_version = "(unknown)" if blocked_version.empty?
  state = submission.state.to_s

  state_human =
    case state
    when "WAITING_FOR_REVIEW" then "waiting for review"
    when "IN_REVIEW" then "in review"
    when "UNRESOLVED_ISSUES" then "blocked by unresolved review issues"
    else
      state.empty? ? "in review" : state.downcase.tr("_", " ")
    end

  if blocked_version == version.to_s
    UI.user_error!(
      "v#{version} is already #{state_human} on the #{store_label}.\n" \
      "Do not re-run auto-submit. In App Store Connect, verify the attached " \
      "build and What's New are correct, or remove from review and fix " \
      "manually, then re-run App Store submission with skip_binary_upload " \
      "if needed."
    )
  end

  UI.user_error!(
    "v#{blocked_version} is already #{state_human} on the #{store_label}.\n" \
    "Refusing to submit v#{version} automatically (would risk attaching the " \
    "wrong build).\n" \
    "In App Store Connect: remove v#{blocked_version} from review (or wait " \
    "for approval), merge What's New into the v#{version} changelog if that " \
    "version never shipped, then re-run this workflow."
  )
end

platform :mac do
  desc "Upload MAS pkg + What's new to App Store Connect and submit for review"
  lane :submit_mac_app_store do |options|
    api_key = load_api_key
    notes = read_notes(options)
    listing = load_listing_copy
    version = options.fetch(:version)
    locale = asc_locale

    pkg = resolve_path(options[:pkg])
    UI.user_error!("PKG not found: #{options[:pkg]}") if !options[:pkg].to_s.strip.empty? && !File.exist?(pkg.to_s)
    build_number = options[:build_number].to_s.strip
    build_number = nil if build_number.empty?

    fail_if_app_store_review_in_progress!(
      app_identifier: APP_IDENTIFIER,
      platform: "osx",
      version: version
    )

    # Never use locale "default" alone — stamp the real primary language.
    deliver(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      app_version: version,
      platform: "osx",
      pkg: pkg,
      skip_binary_upload: pkg.nil?,
      build_number: build_number,
      languages: [locale],
      description: { locale => listing[:description] },
      release_notes: { locale => notes },
      promotional_text: { locale => listing[:promotional_text] },
      submit_for_review: true,
      automatic_release: true,
      skip_screenshots: true,
      skip_metadata: false,
      force: true,
      run_precheck_before_submit: false,
      submission_information: {
        export_compliance_uses_encryption: false
      }
    )
  end
end

platform :ios do
  desc "Upload IPA + What's new to App Store Connect and submit for review"
  lane :submit_ios_app_store do |options|
    api_key = load_api_key
    notes = read_notes(options)
    listing = load_listing_copy
    version = options.fetch(:version)
    locale = asc_locale

    ipa = resolve_path(options[:ipa])
    UI.user_error!("IPA not found: #{options[:ipa]}") if !options[:ipa].to_s.strip.empty? && !File.exist?(ipa.to_s)
    build_number = options[:build_number].to_s.strip
    build_number = nil if build_number.empty?

    fail_if_app_store_review_in_progress!(
      app_identifier: APP_IDENTIFIER,
      platform: "ios",
      version: version
    )

    deliver(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      app_version: version,
      platform: "ios",
      ipa: ipa,
      skip_binary_upload: ipa.nil?,
      build_number: build_number,
      languages: [locale],
      description: { locale => listing[:description] },
      release_notes: { locale => notes },
      promotional_text: { locale => listing[:promotional_text] },
      submit_for_review: true,
      automatic_release: true,
      skip_screenshots: true,
      skip_metadata: false,
      force: true,
      run_precheck_before_submit: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false
      }
    )
  end
end
